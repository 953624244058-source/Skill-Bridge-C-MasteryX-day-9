
#include <stdio.h>

int main() {
    int a[100], n, i;
    int largest, second;

    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }

    largest = a[0];
    second = a[0];
    
    int found = 0;

    for (i = 1; i < n; i++) {
        if (a[i] > largest) {
            second = largest;
            largest = a[i];
            found = 1;
        } else if (a[i] < largest &&
                   (!found || a[i] > second)) {
            second = a[i];
            found = 1;
        }
    }

    if (found)
        printf("Second largest = %d", second);
    else
        printf("Second largest does not exist");

    return 0;
}
